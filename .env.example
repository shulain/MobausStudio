# Mixpanel 运营统计配置
# v2.6.0: 从 Amplitude 迁移到 Mixpanel

# Mixpanel Project Token（必填）
# 从 https://mixpanel.com/project/YOUR_PROJECT_ID/settings 获取
VITE_MIXPANEL_TOKEN=your_mixpanel_token_here

# Mixpanel 代理端点（可选，用于绕过广告拦截器）
# 如果使用 Cloudflare Worker 代理，填写代理 URL
VITE_MIXPANEL_PROXY=https://your-proxy-endpoint.workers.dev
